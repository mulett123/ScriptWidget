<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skrip"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_script"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Perbarui otomatis"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tema warna"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/et_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Warna latar, mis. #CC1E1E2E"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/et_fg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Warna teks, mis. #FFFFFFFF"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/et_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ukuran teks (sp), mis. 14"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Saat widget diketuk"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/sp_tap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Simpan widget" />
    </LinearLayout>
</ScrollView>
